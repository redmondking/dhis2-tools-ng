lxc exec $NAME -- ufw allow proto udp from $LXDBRADDR to any port 514
lxc exec $NAME -- ufw allow proto tcp from $LXDBRADDR to any port 514
lxc exec $NAME -- ufw --force enable

# Listen on udp and tcp 514 and write remote logs to /var/log/<host>/<program>.log
cat <<'CONF' > /tmp/10-remote.conf
module(load="imudp")
input(type="imudp" port="514")
module(load="imtcp")
input(type="imtcp" port="514")

template(name="RemoteLogs" type="string" string="/var/log/%HOSTNAME%/%PROGRAMNAME%.log")
if $fromhost-ip != "127.0.0.1" then {
  action(type="omfile" dynaFile="RemoteLogs")
  stop
}
CONF
lxc file push /tmp/10-remote.conf $NAME/etc/rsyslog.d/10-remote.conf
rm /tmp/10-remote.conf

lxc exec $NAME -- service rsyslog restart
