#!/usr/bin/env bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Set the Glowroot login: the shared one used by all instances, or one instance's own

PROG=$(basename "$0")
# shellcheck source=../lib/dhis2-lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib/dhis2-lib.sh"

usage() {
  cat <<EOF
Usage: $PROG [options] [<instance>]
  (no instance)  set the shared login, and update every running instance that uses it
  instance       give this instance its own login
Glowroot reads its login when tomcat starts, so the affected instances need a restart.
Options:
  -U, --glowroot-user <name>  Glowroot username (default admin)
      --restart yes|no        restart the affected instances now (asked on a terminal, default no; with -y: yes)
      --secrets-stdin         read the password as JSON from stdin: {"glowroot_password": "..."}
  -y, --yes                   ask nothing
      --dry-run               show what would change, change nothing (no password is asked)
  -h, --help                  this help
Exit codes: 0 ok, 1 failure, 3 missing input.
EOF
  exit "${1:-1}"
}

GR_USER_OPT=""
RESTART=""
INSTANCE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -U|--glowroot-user) GR_USER_OPT=${2-}; shift ;;
    --restart) RESTART=${2-}; shift
        [[ $RESTART =~ ^(yes|no)$ ]] || die "--restart takes yes or no" ;;
    --secrets-stdin) secrets_load glowroot_password ;;
    -y|--yes) YES=true ;;
    --dry-run) DRY_RUN=true ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1 (see $PROG --help)" ;;
    *) [[ -z $INSTANCE ]] || die "one instance at a time"; INSTANCE=$1 ;;
  esac
  shift
done
[[ $EUID -eq 0 ]] || die "please run with sudo"

running() { [[ $(lxc list -c s --format csv "^${1}\$") == RUNNING ]]; }

# which instances change
AFFECTED=()
STOPPED=()
if [[ -n $INSTANCE ]]; then
  [[ $(lxc config get "$INSTANCE" user.dhis2.glowroot 2>/dev/null) =~ ^(shared|own)$ ]] \
    || die "$INSTANCE does not exist or has no Glowroot"
  running "$INSTANCE" || die "$INSTANCE is not running"
  AFFECTED=("$INSTANCE")
else
  for C in $(lxc list -c n --format csv); do
    [[ $(lxc config get "$C" user.dhis2.glowroot) == shared ]] || continue
    if running "$C"; then AFFECTED+=("$C"); else STOPPED+=("$C"); fi
  done
fi

if [[ $DRY_RUN == false ]]; then
  if [[ -n $INSTANCE ]]; then
    interactive && echo "Glowroot login for $INSTANCE" >&2
  else
    interactive && echo "Shared Glowroot login, used by every instance set to the shared login" >&2
  fi
  glowroot_new_login "$GR_USER_OPT" glowroot_password
fi
if [[ -z $RESTART && ${#AFFECTED[@]} -gt 0 ]]; then
  if [[ $YES == true ]]; then
    RESTART=yes
  elif interactive; then
    ask_yes_no "Restart tomcat on ${AFFECTED[*]} after the change? DHIS2 will be down for a few minutes" n \
      && RESTART=yes || RESTART=no
  fi
fi
check_missing

if [[ -n $INSTANCE ]]; then summary Login "own login for $INSTANCE"; else summary Login "the shared login"; fi
[[ $DRY_RUN == true ]] || summary User "$GR_USER"
summary Instances "${AFFECTED[*]:-none running}"
[[ ${#STOPPED[@]} -eq 0 ]] || summary "Not running" "${STOPPED[*]} (run this again once started)"
summary Restart "${RESTART:-no}$( [[ ${RESTART:-no} == no ]] && echo " (the old login stays in use until the next restart)")"
confirm_summary "Set the Glowroot login?"

if [[ -n $INSTANCE ]]; then
  glowroot_write_admin "$INSTANCE" own
else
  glowroot_save_shared
  for C in ${AFFECTED[@]+"${AFFECTED[@]}"}; do glowroot_write_admin "$C" shared; done
fi
[[ ${#AFFECTED[@]} -gt 0 ]] || { echo "Login saved; no running instances to update"; exit 0; }
echo "Updated: ${AFFECTED[*]}"
if [[ ${RESTART:-no} == yes ]]; then
  for C in "${AFFECTED[@]}"; do
    echo "Restarting $C"
    lxc exec "$C" -- service "$(instance_tomcat "$C")" restart
  done
else
  echo "Not restarted: the old login stays in use until the next restart"
fi
