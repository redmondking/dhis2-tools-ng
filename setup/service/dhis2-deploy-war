#!/usr/bin/env bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Deploy a DHIS2 release (or an own war) to an existing instance

PROG=$(basename "$0")
# shellcheck source=../lib/dhis2-lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib/dhis2-lib.sh"

usage() {
  cat <<EOF
Usage: $PROG [options] <instance>
  Deploys within the instance's DHIS2 version (e.g. 2.42.x). Changing to another version (2.41 -> 2.42) is not done here.

What to deploy (asked on a terminal):
  -V, --release <release>   official DHIS2 release, exact name from the list (e.g. 2.42.6)
  -f, --file <war>          own war file on this server
  -l, --url <url>           own war at a URL
      --sha256 <checksum>   check an own war against this sha256
      --based-on <version>  DHIS2 version an own war is built on (e.g. 2.41), if it can't be read from the war
Safety:
      --force               allow going back to an older release of the same version
Automation:
  -y, --yes                 ask nothing (going back also needs --force)
      --dry-run             show what would be deployed, change nothing
  -h, --help                this help
With -y, one of -V, -f or -l is required. Exit codes: 0 ok, 1 failure or refused, 3 missing input.
EOF
  exit "${1:-1}"
}

V_OPT=""
URL=""
FILE=""
SHA_OPT=""
BASED_ON=""
FORCE=false
INSTANCE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -V|--release) V_OPT=$2; shift ;;
    -l|--url) URL=$2; shift ;;
    -f|--file) FILE=$2; shift ;;
    --sha256) SHA_OPT=$2; shift ;;
    --based-on) BASED_ON=$2; shift ;;
    --force) FORCE=true ;;
    -y|--yes) YES=true ;;
    --dry-run) DRY_RUN=true ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1 (see $PROG --help)" ;;
    *) [[ -z $INSTANCE ]] || die "only one instance at a time"; INSTANCE=$1 ;;
  esac
  shift
done

[[ $EUID -eq 0 ]] || die "please run with sudo"
N=0
for X in "$V_OPT" "$URL" "$FILE"; do [[ -n $X ]] && N=$((N + 1)); done
(( N <= 1 )) || die "use only one of -V, -l and -f"
[[ -z $BASED_ON$SHA_OPT || -n $FILE$URL ]] || die "--based-on and --sha256 are only for an own war (-f or -l)"

[[ -n $INSTANCE ]] || ask INSTANCE "Instance" "" "<instance>"
check_missing
[[ $(lxc config get "$INSTANCE" user.type 2>/dev/null) == "Tomcat server" ]] || die "no such DHIS2 instance: $INSTANCE"

TOMCAT=$(instance_tomcat "$INSTANCE")
NOW=$(lxc config get "$INSTANCE" user.dhis2.version)
CURRENT=$NOW
[[ $CURRENT =~ ^2\.[0-9]+\.[0-9] ]] || CURRENT=""   # none, custom or no label: no exact release
LINE=$(lxc config get "$INSTANCE" user.dhis2.line)
[[ -n $LINE || -z $CURRENT ]] || LINE=$(release_line "$CURRENT")
if [[ -n $LINE ]] && (( ${LINE#2.} < OLDEST_LINE )); then
  die "$INSTANCE runs DHIS2 $LINE, older than 2.$OLDEST_LINE, the oldest version these tools deploy"
fi

WARDIR=$(mktemp -d -p /var/tmp dhis2-war.XXXXXX)
trap 'rm -rf "$WARDIR"' EXIT
feed_load

###############################################################
# What to deploy

if [[ $N -eq 0 ]] && interactive; then
  echo "Where does DHIS2 come from?" >&2
  echo "  1) An official release (checked against its published checksum)" >&2
  echo "  2) My own war file on this server" >&2
  echo "  3) My own war at a URL" >&2
  read -r -p "Choice [1]: " CHOICE
  case ${CHOICE:-1} in
    2) until [[ -f $FILE ]]; do ask FILE "Path of the war file"; done ;;
    3) ask URL "URL of the war file" ;;
  esac
fi

RELEASE=""
NEWLINE=""
WARFILE=""
if [[ -n $FILE || -n $URL ]]; then
  SOURCE=custom
  if [[ -n $URL ]]; then
    echo "Downloading $URL" >&2
    curl -fL --progress-bar -o "$WARDIR/dhis.war" "$URL" || die "download failed: $URL"
    WARFILE=$WARDIR/dhis.war
  else
    [[ -f $FILE ]] || die "no such file: $FILE"
    WARFILE=$FILE
  fi
  unzip -tqq "$WARFILE" >/dev/null 2>&1 || die "not a valid war file: ${FILE:-$URL}"
  if [[ -n $SHA_OPT ]]; then
    [[ $(sha256sum "$WARFILE" | cut -d' ' -f1) == "$SHA_OPT" ]] || die "the war does not match --sha256; nothing changed"
  fi
  RELEASE=$(war_release "$WARFILE")
  if [[ -n $RELEASE ]]; then
    NEWLINE=$(release_line "$RELEASE")
  else
    NEWLINE=$BASED_ON
    if [[ -z $NEWLINE ]] && interactive; then
      echo "The DHIS2 version can't be read from this war." >&2
      ask NEWLINE "Which DHIS2 version is it built on (e.g. ${LINE:-2.42})"
    fi
    require "$NEWLINE" "--based-on <version>" "the DHIS2 version the war is built on (it can't be read from the war)"
    RELEASE=custom
  fi
else
  SOURCE=official
  [[ -z $LINE ]] && interactive && echo "$INSTANCE has no recorded DHIS2 version, so every release is listed" >&2
  if ask_release RELEASE "$LINE" "$CURRENT" "$V_OPT"; then NEWLINE=$REL_LINE; fi
fi
check_missing

###############################################################
# Checks, summary and confirmation

OLDER=false
# check_and_confirm: stop unless the instance may move to RELEASE, then show the summary and confirm
check_and_confirm() {
  local needs answer
  needs=$(tomcat_for_line "$NEWLINE")
  [[ $needs == "$TOMCAT" ]] || die "DHIS2 $NEWLINE needs $needs, but $INSTANCE runs $TOMCAT"
  if [[ -n $LINE && $NEWLINE != "$LINE" ]]; then
    die "$INSTANCE runs DHIS2 $LINE: changing to another DHIS2 version ($NEWLINE) is done with the upgrade script, which is not available yet"
  fi
  OLDER=false
  if [[ -n $CURRENT && $RELEASE != custom ]] && release_older "$RELEASE" "$CURRENT"; then
    [[ $FORCE == true ]] || die "$RELEASE is older than $CURRENT, which $INSTANCE runs now. Going back is refused unless you add --force"
    OLDER=true
  fi

  SUMMARY=()
  summary Instance "$INSTANCE ($TOMCAT)"
  summary Now "${NOW:-unknown}"
  case $SOURCE in
    official) summary New "$RELEASE (official release; checked against its published checksum)" ;;
    custom)   summary New "$RELEASE (own war ${FILE:-$URL}; ${SHA_OPT:+checksum matches --sha256}${SHA_OPT:-no published checksum})" ;;
  esac
  [[ $RELEASE != "$CURRENT" ]] || summary Note "the same release again (reinstall)"
  summary Downtime "DHIS2 on $INSTANCE stops while the war is replaced, then takes a few minutes to start"
  if [[ $OLDER == true ]]; then
    summary WARNING "going back from $CURRENT to $RELEASE. DHIS2 releases can change the database, and older code may"
    summary "" "not work with it or may damage data. The safe way back is to restore a backup taken while $INSTANCE ran $RELEASE."
  fi
  confirm_summary "Deploy $RELEASE to $INSTANCE?"
  # the riskiest action also needs the instance name typed (without a terminal, -y was given to get here)
  if [[ $OLDER == true ]] && interactive; then
    read -r -p "Type the instance name ($INSTANCE) to go back anyway: " answer
    [[ $answer == "$INSTANCE" ]] || die "not confirmed, nothing changed"
  fi
}
check_and_confirm

if [[ $SOURCE == official ]]; then
  while true; do
    download_war "$WARDIR"
    case $? in
      0) break ;;
      2) ask_release RELEASE "$LINE" "$CURRENT" ""
         NEWLINE=$REL_LINE
         check_and_confirm ;;
      *) die "could not get a verified download of DHIS2 $RELEASE; nothing changed" ;;
    esac
  done
  WARFILE=$WARDIR/dhis.war
fi

echo "Deploying DHIS2 $RELEASE to $INSTANCE"
deploy_war "$INSTANCE" "$WARFILE" "$RELEASE"
lxc config set "$INSTANCE" user.dhis2.line "$NEWLINE"
lxc config set "$INSTANCE" user.dhis2.source "$SOURCE"
echo "$INSTANCE: DHIS2 $RELEASE is starting at $(server_base_url)/$INSTANCE (this takes a few minutes)"
