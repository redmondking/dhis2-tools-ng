#!/usr/bin/env bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Show the tomcat log of a DHIS2 instance

set -euo pipefail

PROG=$(basename "$0")
# shellcheck source=../lib/dhis2-lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib/dhis2-lib.sh"

usage() {
  cat <<EOF
Usage: $PROG [options] <instance>
Options:
  -f, --follow          follow the live log (like tail -f)
  -r, --reverse         newest first
  -g, --grep <text>     only lines matching this text (a regular expression)
  -S, --since <time>    from this time, e.g. "2026-09-26 10:00" or "1 hour ago"
  -U, --until <time>    up to this time
  -n, --lines <n>       only the last n lines
      --json            one JSON object per line (journalctl -o json)
  -h, --help            this help
Exit codes: 0 ok, 1 failure, 3 missing input.
EOF
  exit "${1:-1}"
}

# needs_value OPTION VALUE: an option that takes a value must have one
needs_value() { [[ -n ${2-} ]] || die "$1 needs a value (see $PROG --help)"; }

ARGS=()
NAME=""
while [[ $# -gt 0 ]]; do
  case $1 in
    -f|--follow) ARGS+=(--follow) ;;
    -r|--reverse) ARGS+=(--reverse) ;;
    -g|--grep) needs_value "$1" "${2-}"; ARGS+=(--grep "$2"); shift ;;
    -S|--since) needs_value "$1" "${2-}"; ARGS+=(--since "$2"); shift ;;
    -U|--until) needs_value "$1" "${2-}"; ARGS+=(--until "$2"); shift ;;
    -n|--lines) [[ ${2-} =~ ^[0-9]+$ ]] || die "$1 needs a number"; ARGS+=(--lines "$2"); shift ;;
    --json) ARGS+=(--output json) ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1 (see $PROG --help)" ;;
    *) [[ -z $NAME ]] || die "one instance at a time"; NAME=$1 ;;
  esac
  shift
done

[[ -n $NAME ]] || ask NAME "Instance" "" "<instance>"
check_missing
[[ $(lxc config get "$NAME" user.type 2>/dev/null) == "Tomcat server" ]] || die "no such DHIS2 instance: $NAME"

# every value goes to journalctl as its own argument: nothing passes through a shell
exec lxc exec "$NAME" -- journalctl --no-pager -u "$(instance_tomcat "$NAME")" ${ARGS[@]+"${ARGS[@]}"}
