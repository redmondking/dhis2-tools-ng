#!/usr/bin/env bash
#########################################################
# postgres backup script v3.0
# author: Bob Jolliffe
# licence: public domain 
#
# using some ideas from 
# http://wiki.postgresql.org/wiki/Automated_Backup_on_Linux
########################################################

case ${1-} in
  --dry-run) DRY_RUN=true ;;
  -h|--help) echo "Usage: $(basename "$0") [--dry-run]"
             echo "  Backs up the databases listed in /usr/local/etc/dhis/dhis2-env. Exits 1 if any backup or the remote copy failed."
             echo "  --dry-run  show what would be backed up, change nothing"
             exit 0 ;;
  "") DRY_RUN=false ;;
  *) echo "Error: unknown option $1" >&2; exit 1 ;;
esac

source /usr/local/etc/dhis/dhis2-env
FAILED=0   # a failed database or remote copy makes the run exit 1
set -o pipefail   # a failed pg_dump must count, not just the gzip after it

if [[ $DRY_RUN == true ]]; then
  echo "Backup folder:        $BACKUP_DIR"
  echo "Today's backups:      daily$( [[ $(date +%u) == "$DAY_OF_WEEK_TO_KEEP" ]] && echo ", weekly")$( [[ $(date +%d) == 01 ]] && echo ", monthly")"
  echo "Plain databases:      ${PLAIN_BACKUPS:-none}"
  echo "Encrypted databases:  ${ENCRYPTED_BACKUPS:-none}"
  echo "Remote copy:          ${REMOTE:-none}"
  echo "Dry run: nothing changed."
  exit 0
fi

function perform_backups()
{
  SUFFIX=$1
  FINAL_BACKUP_DIR=$BACKUP_DIR/backup"$(date +%Y%m%d_%H%M%S)$SUFFIX/"
  echo "Backupdir = $FINAL_BACKUP_DIR"

  if ! mkdir -p $FINAL_BACKUP_DIR; then
        echo "`date` Cannot create backup directory in $FINAL_BACKUP_DIR. Go and fix it!"
        exit 1;
  fi;

  for DBNAME in $PLAIN_BACKUPS
  do
     if ! lxc exec postgres -- pg_dump -O -Fp $DBNAME $EXCLUDED | gzip > $FINAL_BACKUP_DIR"$DBNAME".sql.gz.in_progress; then
        echo "`date` [!!ERROR!!] Failed to produce plain backup of database $DBNAME"
        FAILED=$((FAILED + 1))
     else
        mv $FINAL_BACKUP_DIR"$DBNAME".sql.gz.in_progress $FINAL_BACKUP_DIR"$DBNAME".sql.gz
     fi
  done

 for DBNAME in $ENCRYPTED_BACKUPS
  do
     if ! lxc exec postgres -- pg_dump -O -Fp $DBNAME $EXCLUDED | gzip | openssl $CIPHER -e -pass file:$PASSWORD_FILE -salt > $FINAL_BACKUP_DIR"$DBNAME".sql.gz.enc.in_progress; then
        echo "`date` [!!ERROR!!] Failed to produce encrypted backup of database $DBNAME"
        FAILED=$((FAILED + 1))
     else
        mv $FINAL_BACKUP_DIR"$DBNAME".sql.gz.enc.in_progress $FINAL_BACKUP_DIR"$DBNAME".sql.gz.enc
     fi
  done

  # if a remote backup machine is defined, rsynch to it
  if [ -n "$REMOTE" ]; then
    if ! rsync -avq $BACKUP_DIR/* $REMOTE; then
      echo "`date` [!!ERROR!!] Failed to copy the backups to $REMOTE"
      FAILED=$((FAILED + 1))
    fi
  fi


}

# MONTHLY BACKUPS
DAY_OF_MONTH=`date +%d`
 
if [ $DAY_OF_MONTH = "01" ];
then
	# Delete all expired monthly directories
	# find $BACKUP_DIR -maxdepth 1 -name "*-monthly" -exec rm -rf '{}' ';'
 
	perform_backups "-monthly"
fi
 
# WEEKLY BACKUPS
DAY_OF_WEEK=$(date +%u) #1-7 (Monday-Sunday)
EXPIRED_DAYS=$(expr $((($WEEKS_TO_KEEP * 7) + 1)))
 
if [ $DAY_OF_WEEK = $DAY_OF_WEEK_TO_KEEP ];
then
	# Delete all expired weekly directories
	find $BACKUP_DIR -maxdepth 1 -mtime +$EXPIRED_DAYS -name "*-weekly" -exec rm -rf '{}' ';'
 
	perform_backups "-weekly"
fi

# Delete daily backups 7 days old or more
find $BACKUP_DIR -maxdepth 1 -mtime +$DAYS_TO_KEEP -name "*-daily" -exec rm -rf '{}' ';'
 
perform_backups "-daily"

if [[ $FAILED -gt 0 ]]; then
  echo "`date` $FAILED backup step(s) failed" >&2
  exit 1
fi
