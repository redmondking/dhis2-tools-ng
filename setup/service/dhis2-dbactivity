#!/usr/bin/env bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Show non-idle database connections

PROG=$(basename "$0")
# shellcheck source=../lib/dhis2-lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib/dhis2-lib.sh"

usage() {
  cat <<EOF
Usage: $PROG [options] [<postgres_container>]
Options:
      --postgres <container>  postgres container (default: postgres)
      --json                  output a JSON array: transaction_seconds, query_seconds, database, state, query
  -h, --help                  this help
EOF
  exit "${1:-1}"
}

PG=""
JSON=false
while [[ $# -gt 0 ]]; do
  case $1 in
    --postgres) PG=${2-}; shift ;;
    --json) JSON=true ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1 (see $PROG --help)" ;;
    *) [[ -z $PG ]] || die "one postgres container at a time"; PG=$1 ;;
  esac
  shift
done
PG=${PG:-postgres}
lxc info "$PG" >/dev/null 2>&1 || die "no such container: $PG"

WHERE="state != 'idle' AND datname != 'postgres'"
if [[ $JSON == true ]]; then
  lxc exec "$PG" -- psql -tA -c "SELECT coalesce(json_agg(a), '[]') FROM (
    SELECT extract(epoch FROM now() - xact_start)::int AS transaction_seconds,
           extract(epoch FROM now() - query_start)::int AS query_seconds,
           datname AS database, state, query
    FROM pg_stat_activity WHERE $WHERE ORDER BY now() - xact_start DESC NULLS LAST) a" postgres
else
  lxc exec "$PG" -- psql -c "SELECT now() - xact_start AS transaction, now() - query_start AS query_time,
    datname AS database, state, query FROM pg_stat_activity WHERE $WHERE ORDER BY now() - xact_start DESC NULLS LAST" postgres
fi
