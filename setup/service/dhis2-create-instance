#!/usr/bin/env bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Create a DHIS2 instance: its own container, database and proxy entry, with DHIS2 deployed

PROG=$(basename "$0")
# shellcheck source=../lib/dhis2-lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib/dhis2-lib.sh"

CONF=/usr/local/etc/dhis/containers.json
TOMCAT_SETUP=/usr/local/etc/dhis/tomcat_setup
GLOWROOT_VERSION=0.14.7

APM=$(jq -r .apm $CONF)
PROXY=$(jq -r .proxy $CONF)
PROXY_IP=$(jq -r '.containers[] | select(.name=="proxy") | .ip' $CONF)
MONITORING=$(jq -r .monitoring $CONF)
GLOWROOT_LOGIN=$(jq -r '.glowroot_login // "own"' $CONF)

###############################################################
usage() {
  cat <<EOF
Usage: $PROG [options] <instance> [<ip>] [<postgres_container>]
  instance                    name of the instance (also its container and database name)

What to deploy (asked on a terminal):
  -V, --release <release>     official DHIS2 release, exact name from the list (e.g. 2.42.6)
  -f, --file <war>            own war file on this server
  -l, --url <url>             own war at a URL
      --sha256 <checksum>     check an own war against this sha256
      --based-on <version>    DHIS2 version an own war is built on (e.g. 2.41), if it can't be read from the war
      --no-deploy             create the instance without DHIS2 (deploy later with dhis2-deploy-war)
      --line <version>        with --no-deploy: the DHIS2 version it will run (e.g. 2.42); decides Ubuntu, Tomcat, Java
Monitoring:
  -g, --glowroot yes|no       install Glowroot (default on a terminal: from containers.json "apm")
  -U, --glowroot-user <name>  Glowroot username (default admin)
  -m, --munin yes|no          monitor with Munin (only when Munin is installed; default on a terminal: yes)
Placement:
      --ip <ip>               container IP (default: the next free address ending in .10 to .19)
      --postgres <container>  postgres container (default: postgres)
  -n, --no-database           do not create a database
Automation:
  -y, --yes                   ask nothing: every required value must be given as a flag
      --dry-run               show what would be created, change nothing
      --secrets-stdin         read passwords as JSON from stdin: {"glowroot_password": "..."}
  -h, --help                  this help
With -y these are required: <instance>; -V, -f or -l (or --no-deploy with --line); -g; -m when Munin is installed;
the Glowroot password (in --secrets-stdin) when it is needed. Exit codes: 0 ok, 1 failure, 3 missing input.
EOF
  exit "${1:-1}"
}

NODEPLOY=false
LINE_OPT=""
V_OPT=""
FILE=""
URL=""
SHA_OPT=""
BASED_ON=""
GLOWROOT=""
MUNIN=""
GR_USER_OPT=""
IP_OPT=""
PG_OPT=""
CREATEDB=true
SECRETS_STDIN=false
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -V|--release) V_OPT=$2; shift ;;
    -f|--file) FILE=$2; shift ;;
    -l|--url) URL=$2; shift ;;
    --sha256) SHA_OPT=$2; shift ;;
    --based-on) BASED_ON=$2; shift ;;
    --no-deploy) NODEPLOY=true ;;
    --line) LINE_OPT=$2; shift ;;
    -g|--glowroot) GLOWROOT=$2; shift
        [[ $GLOWROOT =~ ^(yes|no)$ ]] || die "-g/--glowroot takes yes or no" ;;
    -m|--munin) MUNIN=$2; shift
        [[ $MUNIN =~ ^(yes|no)$ ]] || die "-m/--munin takes yes or no" ;;
    -U|--glowroot-user) GR_USER_OPT=$2; shift ;;
    --ip) IP_OPT=$2; shift ;;
    --postgres) PG_OPT=$2; shift ;;
    -n|--no-database) CREATEDB=false ;;
    -y|--yes) YES=true ;;
    --dry-run) DRY_RUN=true ;;
    --secrets-stdin) SECRETS_STDIN=true ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1 (see $PROG --help)" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done

[[ $EUID -eq 0 ]] || die "please run with sudo"
N=0
for X in "$V_OPT" "$FILE" "$URL"; do [[ -n $X ]] && N=$((N + 1)); done
(( N <= 1 )) || die "use only one of -V, -f and -l"
[[ $NODEPLOY == false || $N -eq 0 ]] || die "--no-deploy can't be combined with -V, -f or -l"
[[ -z $LINE_OPT || $NODEPLOY == true ]] || die "--line is only for --no-deploy (otherwise the release decides the version)"
[[ -z $BASED_ON$SHA_OPT || -n $FILE$URL ]] || die "--based-on and --sha256 are only for an own war (-f or -l)"
[[ $SECRETS_STDIN == false ]] || secrets_load glowroot_password

NAME=${ARGS[0]-}
[[ -n $NAME ]] || ask NAME "Instance name" "" "<instance>"
WARDIR=$(mktemp -d -p /var/tmp dhis2-war.XXXXXX)
trap 'rm -rf "$WARDIR"' EXIT

###############################################################
# What to deploy. The version decides Ubuntu, Tomcat and Java.

feed_load
if [[ $NODEPLOY == false && $N -eq 0 ]] && interactive; then
  echo "What do you want to do?" >&2
  echo "  1) Create the instance and deploy DHIS2" >&2
  echo "  2) Create the instance only (deploy DHIS2 later with dhis2-deploy-war)" >&2
  read -r -p "Choice [1]: " CHOICE
  [[ ${CHOICE:-1} == 2 ]] && NODEPLOY=true
fi

# check_line LINE: a DHIS2 version these tools install (2.38 or newer, in the release list)
check_line() {
  [[ $1 =~ ^2\.[0-9]+$ ]] && (( ${1#2.} >= OLDEST_LINE )) && [[ -n $(feed_line_jdk "$1") ]] \
    || die "$1 is not a DHIS2 version these tools install (2.$OLDEST_LINE or newer, e.g. 2.42)"
}

SOURCE=""
RELEASE=""
LINE=""
WARFILE=""
if [[ $NODEPLOY == true ]]; then
  SOURCE=none
  RELEASE=none
  LINE=$LINE_OPT
  if [[ -z $LINE ]] && interactive; then
    echo "Which DHIS2 version will $NAME run? (it decides Ubuntu, Tomcat and Java)" >&2
    feed_show | awk '{print "  " $1 "  " $2 " " $3}' | sed 's/ 2\.[0-9.]*$//' >&2
    ask LINE "Version" "$(release_line "$(feed_newest)")"
  fi
  require "$LINE" "--line <version>" "the DHIS2 version it will run (e.g. 2.42)"
else
  if [[ $N -eq 0 ]] && interactive; then
    echo "Where does DHIS2 come from?" >&2
    echo "  1) An official release (checked against its published checksum)" >&2
    echo "  2) My own war file on this server" >&2
    echo "  3) My own war at a URL" >&2
    read -r -p "Choice [1]: " CHOICE
    case ${CHOICE:-1} in
      2) until [[ -f $FILE ]]; do ask FILE "Path of the war file"; done ;;
      3) ask URL "URL of the war file" ;;
    esac
  fi
  if [[ -n $FILE || -n $URL ]]; then
    SOURCE=custom
    if [[ -n $URL ]]; then
      echo "Downloading $URL" >&2
      curl -fL --progress-bar -o "$WARDIR/dhis.war" "$URL" || die "download failed: $URL"
      WARFILE=$WARDIR/dhis.war
    else
      [[ -f $FILE ]] || die "no such file: $FILE"
      WARFILE=$FILE
    fi
    unzip -tqq "$WARFILE" >/dev/null 2>&1 || die "not a valid war file: ${FILE:-$URL}"
    if [[ -n $SHA_OPT ]]; then
      [[ $(sha256sum "$WARFILE" | cut -d' ' -f1) == "$SHA_OPT" ]] || die "the war does not match --sha256; nothing was created"
    fi
    RELEASE=$(war_release "$WARFILE")
    if [[ -n $RELEASE ]]; then
      LINE=$(release_line "$RELEASE")
    else
      LINE=$BASED_ON
      if [[ -z $LINE ]] && interactive; then
        echo "The DHIS2 version can't be read from this war." >&2
        ask LINE "Which DHIS2 version is it built on (e.g. 2.41)"
      fi
      require "$LINE" "--based-on <version>" "the DHIS2 version the war is built on (it can't be read from the war)"
      RELEASE=custom
    fi
  else
    SOURCE=official
    if ask_release RELEASE "" "" "$V_OPT"; then
      LINE=$REL_LINE
    fi
  fi
fi

###############################################################
# Monitoring

if [[ -z $GLOWROOT ]]; then
  if interactive; then
    [[ $APM == glowroot ]] && DEFAULT=y || DEFAULT=n
    ask_yes_no "Install Glowroot on $NAME?" $DEFAULT && GLOWROOT=yes || GLOWROOT=no
  else
    require "" "-g/--glowroot yes|no" "install Glowroot"
  fi
fi
if [[ $MONITORING != munin ]]; then
  MUNIN=no
elif [[ -z $MUNIN ]]; then
  if interactive; then
    ask_yes_no "Monitor $NAME with Munin?" y && MUNIN=yes || MUNIN=no
  else
    require "" "-m/--munin yes|no" "monitor with Munin"
  fi
fi
SAVE_SHARED=false
if [[ $GLOWROOT == yes ]]; then
  if [[ $GLOWROOT_LOGIN == shared ]]; then
    if ! glowroot_load_shared; then
      interactive && echo "Set the shared Glowroot login, used by every instance on this server" >&2
      glowroot_new_login "$GR_USER_OPT" glowroot_password
      SAVE_SHARED=true   # saved only after the summary is confirmed
    fi
  else
    interactive && echo "Glowroot login for $NAME" >&2
    glowroot_new_login "$GR_USER_OPT" glowroot_password
  fi
fi

check_missing

# checks that need the name: container, IP, database
[[ $NAME =~ ^[a-z][a-z0-9-]{0,62}$ && $NAME != *- ]] \
  || die "instance names use lowercase letters, digits and '-', start with a letter, and are at most 63 characters"

NETPREFIX=$(ip addr | awk '/inet.*lxdbr0/ {print $2}'|grep -o -e '^[0-9]*.[0-9]*.[0-9]*')
# configured (not just running) addresses, so stopped containers keep their IP
USED=$(for C in $(lxc list -c n --format csv); do lxc config device get "$C" eth0 ipv4.address 2>/dev/null; done)
FREEIP=""
for N in {10..19}; do
  grep -qx "${NETPREFIX}.${N}" <<< "$USED" || { FREEIP="${NETPREFIX}.${N}"; break; }
done

IP=${IP_OPT:-${ARGS[1]:-$FREEIP}}
PG=${PG_OPT:-${ARGS[2]:-postgres}}
[[ -n $IP ]] || die "no free IP in ${NETPREFIX}.10-19: give one with --ip"

# convert IP to regex
IPREGEX=$(echo $IP |sed "s/\./\\\./g")

lxc info "$NAME" >/dev/null 2>&1 && die "container $NAME already exists"
grep -qx "$IP" <<< "$USED" && die "$IP is already in use"

if [[ $CREATEDB == true ]]; then
  lxc info "$PG" >/dev/null 2>&1 || die "no such container: $PG"
  PGVERSION=$(lxc exec $PG -- psql -t -c 'select version()' postgres |awk '/PostgreSQL/ {print $2}')
  [[ -n $PGVERSION ]] || die "can't connect to a postgres server on $PG"
  PGMAJOR=$(echo $PGVERSION |cut -d. -f 1)
  lxc exec $PG -- psql -lqt --csv |cut -d ',' -f 1 |grep -qx "$NAME" && die "database $NAME already exists on $PG"
  lxc exec $PG -- psql --csv -qt -c '\du' postgres |cut -d, -f1 |grep -qx "$NAME" && die "database user $NAME already exists on $PG"
fi

[[ -z $LINE ]] || check_line "$LINE"
JAVA_VERSION=$(feed_line_jdk "$LINE")
TOMCAT=$(tomcat_for_line "$LINE")
GUESTOS=$(guestos_for_tomcat "$TOMCAT")
if [[ $TOMCAT == tomcat10 ]] && ! grep -q TOMCAT $TOMCAT_SETUP; then
  die "$TOMCAT_SETUP is from an older version: run sudo dhis2-upgrade-setup first"
fi

###############################################################
# Summary, then the checked download of an official release (another release can be chosen if it fails)

show_summary() {
  SUMMARY=()
  summary Instance "$NAME ($IP)"
  if [[ $CREATEDB == true ]]; then summary Database "$NAME on $PG"; else summary Database "none (-n)"; fi
  case $SOURCE in
    none)     summary DHIS2 "not deployed now (DHIS2 $LINE; deploy later with dhis2-deploy-war)" ;;
    official) summary DHIS2 "$RELEASE (official release; checked against its published checksum)" ;;
    custom)   summary DHIS2 "$RELEASE (own war ${FILE:-$URL}; ${SHA_OPT:+checksum matches --sha256}${SHA_OPT:-no published checksum})" ;;
  esac
  summary "Runs on" "Ubuntu $GUESTOS, $TOMCAT, Java $JAVA_VERSION"
  if [[ $GLOWROOT == yes ]]; then summary Glowroot "yes ($GLOWROOT_LOGIN login, user $GR_USER)"; else summary Glowroot no; fi
  summary Munin "$MUNIN"
  confirm_summary "Create $NAME?"
}
show_summary

if [[ $SOURCE == official ]]; then
  while true; do
    download_war "$WARDIR"
    case $? in
      0) break ;;
      2) ask_release RELEASE "" "" ""
         LINE=$REL_LINE
         JAVA_VERSION=$(feed_line_jdk "$LINE")
         TOMCAT=$(tomcat_for_line "$LINE")
         GUESTOS=$(guestos_for_tomcat "$TOMCAT")
         show_summary ;;
      *) die "could not get a verified download of DHIS2 $RELEASE; nothing was created" ;;
    esac
  done
  WARFILE=$WARDIR/dhis.war
fi
echo "$NAME: ${RELEASE/#none/no DHIS2 yet,} $TOMCAT, Java $JAVA_VERSION, Ubuntu $GUESTOS"
[[ $SAVE_SHARED == false ]] || glowroot_save_shared

if [[ $CREATEDB == true ]]
then
  echo "########################################"
  echo "Creating database $NAME on $PG"
  echo "########################################"
  PASSWD=$(openssl rand -hex 20)
  lxc exec $PG -- createuser $NAME
  lxc exec $PG -- psql -c "ALTER user $NAME with PASSWORD '$PASSWD'" postgres 
  lxc exec $PG -- createdb -O $NAME $NAME
  lxc exec $PG -- psql -c "CREATE EXTENSION postgis" $NAME
  lxc exec $PG -- psql -c "CREATE EXTENSION btree_gin" $NAME
  lxc exec $PG -- psql -c "CREATE EXTENSION pg_trgm" $NAME


  # Fixing pg_hba.conf permissions
  # get rid of any existing lines for the IP
  lxc exec $PG -- sed -i "/$IPREGEX/d" /etc/postgresql/$PGMAJOR/main/pg_hba.conf
  lxc exec $PG -- sed -i "$ a\
    host $NAME $NAME $IP/32 md5" /etc/postgresql/$PGMAJOR/main/pg_hba.conf
      lxc exec $PG -- service postgresql reload
      # add firewall rule
      lxc exec $PG ufw allow proto tcp from $IP to any port 5432
fi

echo "####################################"
echo "Creating tomcat container $NAME"
echo "####################################"

lxc init ubuntu:$GUESTOS $NAME

# set ip addresses
sudo lxc network attach lxdbr0 $NAME eth0 eth0
sudo lxc config device set $NAME eth0 ipv4.address $IP

# lxc config set $NAME boot.autostart false
lxc config set $NAME user.type "Tomcat server"
lxc config set $NAME user.dhis2.tomcat $TOMCAT
lxc config set $NAME user.dhis2.java $JAVA_VERSION
lxc config set $NAME user.dhis2.line $LINE
lxc config set $NAME user.dhis2.source $SOURCE
lxc start $NAME 

# wait for network to come up
until lxc exec $NAME -- getent hosts archive.ubuntu.com >/dev/null; do
  echo waiting for network; sleep 1
done

# Added PROXY_IP to tomcat_setup
sed -e "s/PROXY_IP/${PROXY_IP}/" -e "s/JAVA_VERSION/${JAVA_VERSION}/" -e "s/TOMCAT/${TOMCAT}/g" \
    $TOMCAT_SETUP > $WARDIR/tomcat_setup
lxc exec $NAME -- bash < $WARDIR/tomcat_setup

if [[ $CREATEDB == true ]]
then	
  lxc exec $NAME -- sed -i "s/^connection.username.*$/connection.username = $NAME/" /opt/dhis2/dhis.conf
  lxc exec $NAME -- sed -i "s/^connection.password.*$/connection.password = $PASSWD/" /opt/dhis2/dhis.conf
  lxc exec $NAME -- sed -i "s/^connection.url.*$/connection.url = jdbc:postgresql:\/\/$PG\/$NAME/" /opt/dhis2/dhis.conf
fi

# render /etc/default/<tomcat> for this java version and cpu architecture
# ({{ JAVA_VERSION }} is the placeholder in tomcat_default files from older installs)
JAVA_ARCH=$(lxc exec $NAME -- dpkg --print-architecture)
sed -e "s/{{ JAVA_VERSION }}/${JAVA_VERSION}/" -e "s/JAVA_VERSION/${JAVA_VERSION}/" \
    -e "s/JAVA_ARCH/${JAVA_ARCH}/" /usr/local/etc/dhis/tomcat_default > $WARDIR/tomcat_default

if [[ $GLOWROOT == yes ]]
then
  sed -ri '/glowroot.jar/ s/..(.*)/\1/' $WARDIR/tomcat_default

  GLOWROOT_ZIP=glowroot-$GLOWROOT_VERSION-dist.zip
  lxc exec $NAME -- wget -q -P /opt https://github.com/glowroot/glowroot/releases/download/v$GLOWROOT_VERSION/$GLOWROOT_ZIP
  lxc exec $NAME -- unzip -o -q /opt/$GLOWROOT_ZIP -d /opt
  lxc exec $NAME -- rm /opt/$GLOWROOT_ZIP
  lxc exec $NAME -- chown -R tomcat:tomcat /opt/glowroot
  glowroot_write_admin $NAME $GLOWROOT_LOGIN
  lxc exec $NAME ufw allow proto tcp from $PROXY_IP to any port 4000
else
  lxc config set $NAME user.dhis2.glowroot off
fi
lxc file push $WARDIR/tomcat_default $NAME/etc/default/$TOMCAT
lxc exec $NAME -- chmod 644 /etc/default/$TOMCAT
lxc exec $NAME -- systemctl daemon-reload
lxc exec $NAME -- service rsyslog restart
# before tomcat starts below, so it picks up the monitoring user
if [[ $MUNIN == yes ]]; then
  "$(dirname "$(readlink -f "$0")")/dhis2-tomcat-munin" $NAME
fi
lxc config set $NAME user.dhis2.munin $MUNIN

# deploy the war and start tomcat (create only: start tomcat without DHIS2)
if [[ $SOURCE == none ]]; then
  lxc config set $NAME user.dhis2.version none
  lxc exec $NAME -- service $TOMCAT restart
else
  deploy_war $NAME "$WARFILE" "$RELEASE"
fi

# Append to bottom /etc/hosts
sudo sed -i "/$IP/d" /etc/hosts
sudo sed -i "$ a\
  $IP $NAME" /etc/hosts


if [[ $PROXY == "nginx" ]];
then
#if proxy is nginx ;
  cat <<EOF > /tmp/${NAME}.conf
    # Proxy pass to servlet container

    location /${NAME} {
      proxy_pass                http://${IP}:8080/${NAME};
      proxy_redirect            off;
      proxy_set_header Host \$host;
      proxy_set_header X-Real-IP \$remote_addr;
      proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto  \$scheme;
	  proxy_hide_header X-Frame-Options;
      proxy_hide_header Strict-Transport-Security;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header X-XSS-protection;
	  proxy_hide_header X-Powered-By;
	  proxy_hide_header Server;

      proxy_connect_timeout  480s;
      proxy_read_timeout     480s;
      proxy_send_timeout     480s;

      proxy_buffer_size        128k;
      proxy_buffers            8 128k;
      proxy_busy_buffers_size  256k;
   }
EOF

  lxc file push /tmp/${NAME}.conf proxy/etc/nginx/upstream/${NAME}.conf
  rm /tmp/${NAME}.conf
  
  if [[ $GLOWROOT == yes ]]
  then
    cat <<EOF > /tmp/${NAME}-glowroot.conf
    # Proxy pass to servlet container

    location /${NAME}-glowroot {
      proxy_pass                http://${IP}:4000/${NAME}-glowroot;
      proxy_redirect            off;
      proxy_set_header Host \$host;
      proxy_set_header X-Real-IP \$remote_addr;
      proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto  \$scheme;
	  proxy_hide_header X-Frame-Options;
      proxy_hide_header Strict-Transport-Security;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header X-XSS-protection;
	  proxy_hide_header X-Powered-By;
	  proxy_hide_header Server;

      proxy_connect_timeout  480s;
      proxy_read_timeout     480s;
      proxy_send_timeout     480s;

      proxy_buffer_size        128k;
      proxy_buffers            8 128k;
      proxy_busy_buffers_size  256k;
   }
EOF

    lxc file push /tmp/${NAME}-glowroot.conf proxy/etc/nginx/upstream/${NAME}-glowroot.conf
    rm /tmp/${NAME}-glowroot.conf
  fi
  
  lxc exec proxy -- service nginx restart
elif [[ $PROXY == "apache2" ]];
then
#if proxy is apache2 ;
  cat <<EOF > /tmp/${NAME}
  <Location /${NAME}>
    Require all granted
    ProxyPass "http://${IP}:8080/${NAME}"
    ProxyPassReverse "http://${IP}:8080/${NAME}"
  </Location>
EOF

  lxc file push /tmp/${NAME} proxy/etc/apache2/upstream/${NAME}
  rm /tmp/${NAME}
  
  if [[ $GLOWROOT == yes ]]
  then
    cat <<EOF > /tmp/${NAME}-glowroot
  <Location /${NAME}-glowroot>
    Require all granted
    ProxyPass "http://${IP}:4000/${NAME}-glowroot"
    ProxyPassReverse "http://${IP}:4000/${NAME}-glowroot"
  </Location>
EOF

    lxc file push /tmp/${NAME}-glowroot proxy/etc/apache2/upstream/${NAME}-glowroot
    rm /tmp/${NAME}-glowroot
  fi
  
  lxc exec proxy -- service apache2 restart
else
  echo "Error: Proxy type not supported"
  exit 1
fi

if [[ $SOURCE == none ]]; then
  echo "$NAME is ready for DHIS2 $LINE: deploy it with: sudo dhis2-deploy-war $NAME"
else
  echo "$NAME: DHIS2 $RELEASE is starting at $(server_base_url)/$NAME (the first start takes a few minutes)"
fi
