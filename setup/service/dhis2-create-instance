#!/usr/bin/env bash
#       ____  __  ______________
#      / __ \/ / / /  _/ ___/__ \
#     / / / / /_/ // / \__ \__/ /
#    / /_/ / __  // / ___/ / __/
#   /_____/_/ /_/___//____/____/
#
#   Script to deploy a dhis2 instance

PROG=$(basename "$0")
source "$(dirname "$(readlink -f "$0")")/../lib/dhis2-lib.sh"

CONF=/usr/local/etc/dhis/containers.json
CREATEDB=true
TOMCAT_SETUP=/usr/local/etc/dhis/tomcat_setup
GLOWROOT_VERSION=0.14.7

APM=$(jq -r .apm $CONF)
PROXY=$(jq -r .proxy $CONF)
PROXY_IP=$(jq -r '.containers[] | select(.name=="proxy") | .ip' $CONF)
MONITORING=$(jq -r .monitoring $CONF)
GLOWROOT_LOGIN=$(jq -r '.glowroot_login // "own"' $CONF)

###############################################################
usage() {
  echo "Usage: $PROG [options] <instance> [<ip>] [<postgres_container>]"
  echo "  instance: name of the dhis2 instance to create"
  echo "  ip: the ip address of the container (default picks next free IP ending in .10 to .19"
  echo "  postgres_container: the name of postgresql container (default postgres)"
  echo "Options:"
  echo "  -h, --help        Display this help message"
  echo "  -n                Do NOT create database for instance"
  echo "  -V <release>      DHIS2 release, exact name from the list (e.g. 2.42.6); asked on a terminal"
  echo "  -g <yes|no>       Install Glowroot (default from containers.json \"apm\", asked on a terminal)"
  echo "  -m <yes|no>       Monitor with Munin (only when Munin is installed; default yes)"
  echo "  -U <username>     Glowroot username (default admin)"
  echo "  --password-stdin  Read the Glowroot password from stdin"
  exit "${1:-1}"
}

GLOWROOT=""
MUNIN=""
GR_USER_OPT=""
V_OPT=""
PASSWORD_STDIN=false
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -n) CREATEDB=false ;;
    -V) V_OPT=$2; shift ;;
    -g) GLOWROOT=$2; shift
        [[ $GLOWROOT =~ ^(yes|no)$ ]] || usage ;;
    -m) MUNIN=$2; shift
        [[ $MUNIN =~ ^(yes|no)$ ]] || usage ;;
    -U) GR_USER_OPT=$2; shift ;;
    --password-stdin) PASSWORD_STDIN=true ;;
    -h|--help) usage 0 ;;
    -*) die "unknown option $1" ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]}"

if [ "$#" -lt 1 ]; then
  usage
fi

NAME=$1

NETPREFIX=$(ip addr | awk '/inet.*lxdbr0/ {print $2}'|grep -o -e '^[0-9]*.[0-9]*.[0-9]*')
# configured (not just running) addresses, so stopped containers keep their IP
USED=$(for C in $(lxc list -c n --format csv); do lxc config device get "$C" eth0 ipv4.address 2>/dev/null; done)
FREEIP=""
for N in {10..19}; do
  grep -qx "${NETPREFIX}.${N}" <<< "$USED" || { FREEIP="${NETPREFIX}.${N}"; break; }
done

IP=${2:-${FREEIP}}
PG=${3:-postgres}

if [[ -z $IP ]]; then
  echo "No free IP in ${NETPREFIX}.10-19, please give one explicitly"
  exit 1
fi

# convert IP to regex
IPREGEX=$(echo $IP |sed "s/\./\\\./g")

# check Container name is available
if lxc info "$NAME" >/dev/null 2>&1;
then 
  echo Container $1 already exists;
  exit 1  
fi

# Check IP is available
if grep -qx "$IP" <<< "$USED";
then
  echo "$IP already in use"
  exit 1
fi

# Monitoring choices, asked before anything is created
if [[ -z $GLOWROOT ]]; then
  [[ $APM == glowroot ]] && DEFAULT=y || DEFAULT=n
  ask_yes_no "Install Glowroot on $NAME?" $DEFAULT && GLOWROOT=yes || GLOWROOT=no
fi
if [[ $MONITORING != munin ]]; then
  MUNIN=no
elif [[ -z $MUNIN ]]; then
  ask_yes_no "Monitor $NAME with Munin?" y && MUNIN=yes || MUNIN=no
fi
if [[ $GLOWROOT == yes ]]; then
  if [[ $GLOWROOT_LOGIN == shared ]]; then
    if ! glowroot_load_shared; then
      [[ -t 0 || $PASSWORD_STDIN == true ]] || die "there is no shared Glowroot login yet: set it with dhis2-glowroot-login"
      echo "Set the shared Glowroot login, used by every instance on this server"
      glowroot_new_login "$GR_USER_OPT" $PASSWORD_STDIN
      glowroot_save_shared
    fi
  else
    echo "Glowroot login for $NAME"
    glowroot_new_login "$GR_USER_OPT" $PASSWORD_STDIN
  fi
fi

# DHIS2 release: it decides the container OS, tomcat and java.
# The war is downloaded and checked before anything is created.
feed_load
ask_release RELEASE "" "" "$V_OPT"
TOMCAT=$(tomcat_for_line "$REL_LINE")
GUESTOS=$(guestos_for_tomcat "$TOMCAT")
JAVA_VERSION=$REL_JDK
if [[ $TOMCAT == tomcat10 ]] && ! grep -q TOMCAT $TOMCAT_SETUP; then
  die "$TOMCAT_SETUP is from an older version: run sudo dhis2-upgrade-setup first"
fi
WARDIR=$(mktemp -d -p /var/tmp dhis2-war.XXXXXX)
trap 'rm -rf "$WARDIR"' EXIT
download_war "$WARDIR" || die "could not get a verified download of DHIS2 $RELEASE; nothing was created"
echo "$NAME: DHIS2 $RELEASE on $TOMCAT, Java $JAVA_VERSION, Ubuntu $GUESTOS"

if [[ $CREATEDB == true ]]
then

  # Check if Postgres container exists
  if ! lxc info "$PG" >/dev/null 2>&1;
  then
    echo No such container $PG;
    exit 1
  fi

  # Check postgres version
  PGVERSION=$(lxc exec $PG -- psql -t -c 'select version()' postgres |awk '/PostgreSQL/ {print $2}')
  if [ -z $PGVERSION ] 
  then
    echo "Cant connect to a postgres server on $PG"
    exit 1
  fi
  PGMAJOR=$(echo $PGVERSION |cut -d. -f 1)

  # Check if database already exists
  if lxc exec $PG -- psql -lqt --csv |cut -d ',' -f 1 |grep -qx "$NAME"
  then
    echo "Database $NAME already exists"
    exit 1
  fi

  # Check if database user already exists
  if lxc exec $PG -- psql --csv -qt -c '\du' postgres |cut -d, -f1 |grep -qx "$NAME"
  then
    echo "User $NAME already exists"
    exit 1
  fi
  echo "########################################"
  echo "Creating database $NAME on $PG"
  echo "########################################"
  PASSWD=$(openssl rand -hex 20)
  lxc exec $PG -- createuser $NAME
  lxc exec $PG -- psql -c "ALTER user $NAME with PASSWORD '$PASSWD'" postgres 
  lxc exec $PG -- createdb -O $NAME $NAME
  lxc exec $PG -- psql -c "CREATE EXTENSION postgis" $NAME
  lxc exec $PG -- psql -c "CREATE EXTENSION btree_gin" $NAME
  lxc exec $PG -- psql -c "CREATE EXTENSION pg_trgm" $NAME


  # Fixing pg_hba.conf permissions
  # get rid of any existing lines for the IP
  lxc exec $PG -- sed -i "/$IPREGEX/d" /etc/postgresql/$PGMAJOR/main/pg_hba.conf
  lxc exec $PG -- sed -i "$ a\
    host $NAME $NAME $IP/32 md5" /etc/postgresql/$PGMAJOR/main/pg_hba.conf
      lxc exec $PG -- service postgresql reload
      # add firewall rule
      lxc exec $PG ufw allow proto tcp from $IP to any port 5432
fi

echo "####################################"
echo "Creating tomcat container $NAME"
echo "####################################"

lxc init ubuntu:$GUESTOS $NAME

# set ip addresses
sudo lxc network attach lxdbr0 $NAME eth0 eth0
sudo lxc config device set $NAME eth0 ipv4.address $IP

# lxc config set $NAME boot.autostart false
lxc config set $NAME user.type "Tomcat server"
lxc config set $NAME user.dhis2.tomcat $TOMCAT
lxc config set $NAME user.dhis2.java $JAVA_VERSION
lxc start $NAME 

# wait for network to come up
until lxc exec $NAME -- getent hosts archive.ubuntu.com >/dev/null; do
  echo waiting for network; sleep 1
done

# Added PROXY_IP to tomcat_setup
sed -e "s/PROXY_IP/${PROXY_IP}/" -e "s/JAVA_VERSION/${JAVA_VERSION}/" -e "s/TOMCAT/${TOMCAT}/g" \
    $TOMCAT_SETUP > $WARDIR/tomcat_setup
lxc exec $NAME -- bash < $WARDIR/tomcat_setup

if [[ $CREATEDB == true ]]
then	
  lxc exec $NAME -- sed -i "s/^connection.username.*$/connection.username = $NAME/" /opt/dhis2/dhis.conf
  lxc exec $NAME -- sed -i "s/^connection.password.*$/connection.password = $PASSWD/" /opt/dhis2/dhis.conf
  lxc exec $NAME -- sed -i "s/^connection.url.*$/connection.url = jdbc:postgresql:\/\/$PG\/$NAME/" /opt/dhis2/dhis.conf
fi

# render /etc/default/<tomcat> for this java version and cpu architecture
# ({{ JAVA_VERSION }} is the placeholder in tomcat_default files from older installs)
JAVA_ARCH=$(lxc exec $NAME -- dpkg --print-architecture)
sed -e "s/{{ JAVA_VERSION }}/${JAVA_VERSION}/" -e "s/JAVA_VERSION/${JAVA_VERSION}/" \
    -e "s/JAVA_ARCH/${JAVA_ARCH}/" /usr/local/etc/dhis/tomcat_default > $WARDIR/tomcat_default

if [[ $GLOWROOT == yes ]]
then
  sed -ri '/glowroot.jar/ s/..(.*)/\1/' $WARDIR/tomcat_default

  GLOWROOT_ZIP=glowroot-$GLOWROOT_VERSION-dist.zip
  lxc exec $NAME -- wget -q -P /opt https://github.com/glowroot/glowroot/releases/download/v$GLOWROOT_VERSION/$GLOWROOT_ZIP
  lxc exec $NAME -- unzip -o -q /opt/$GLOWROOT_ZIP -d /opt
  lxc exec $NAME -- rm /opt/$GLOWROOT_ZIP
  lxc exec $NAME -- chown -R tomcat:tomcat /opt/glowroot
  glowroot_write_admin $NAME $GLOWROOT_LOGIN
  lxc exec $NAME ufw allow proto tcp from $PROXY_IP to any port 4000
else
  lxc config set $NAME user.dhis2.glowroot off
fi
lxc file push $WARDIR/tomcat_default $NAME/etc/default/$TOMCAT
lxc exec $NAME -- chmod 644 /etc/default/$TOMCAT
lxc exec $NAME -- systemctl daemon-reload
lxc exec $NAME -- service rsyslog restart
# before tomcat starts below, so it picks up the monitoring user
if [[ $MUNIN == yes ]]; then
  "$(dirname "$(readlink -f "$0")")/dhis2-tomcat-munin" $NAME
fi
lxc config set $NAME user.dhis2.munin $MUNIN

# deploy the checked war and start tomcat
deploy_war $NAME "$WARDIR/dhis.war" "$RELEASE"

# Append to bottom /etc/hosts
sudo sed -i "/$IP/d" /etc/hosts
sudo sed -i "$ a\
  $IP $NAME" /etc/hosts


if [[ $PROXY == "nginx" ]];
then
#if proxy is nginx ;
  cat <<EOF > /tmp/${NAME}.conf
    # Proxy pass to servlet container

    location /${NAME} {
      proxy_pass                http://${IP}:8080/${NAME};
      proxy_redirect            off;
      proxy_set_header Host \$host;
      proxy_set_header X-Real-IP \$remote_addr;
      proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto  \$scheme;
	  proxy_hide_header X-Frame-Options;
      proxy_hide_header Strict-Transport-Security;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header X-XSS-protection;
	  proxy_hide_header X-Powered-By;
	  proxy_hide_header Server;

      proxy_connect_timeout  480s;
      proxy_read_timeout     480s;
      proxy_send_timeout     480s;

      proxy_buffer_size        128k;
      proxy_buffers            8 128k;
      proxy_busy_buffers_size  256k;
   }
EOF

  lxc file push /tmp/${NAME}.conf proxy/etc/nginx/upstream/${NAME}.conf
  rm /tmp/${NAME}.conf
  
  if [[ $GLOWROOT == yes ]]
  then
    cat <<EOF > /tmp/${NAME}-glowroot.conf
    # Proxy pass to servlet container

    location /${NAME}-glowroot {
      proxy_pass                http://${IP}:4000/${NAME}-glowroot;
      proxy_redirect            off;
      proxy_set_header Host \$host;
      proxy_set_header X-Real-IP \$remote_addr;
      proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto  \$scheme;
	  proxy_hide_header X-Frame-Options;
      proxy_hide_header Strict-Transport-Security;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header X-XSS-protection;
	  proxy_hide_header X-Powered-By;
	  proxy_hide_header Server;

      proxy_connect_timeout  480s;
      proxy_read_timeout     480s;
      proxy_send_timeout     480s;

      proxy_buffer_size        128k;
      proxy_buffers            8 128k;
      proxy_busy_buffers_size  256k;
   }
EOF

    lxc file push /tmp/${NAME}-glowroot.conf proxy/etc/nginx/upstream/${NAME}-glowroot.conf
    rm /tmp/${NAME}-glowroot.conf
  fi
  
  lxc exec proxy -- service nginx restart
elif [[ $PROXY == "apache2" ]];
then
#if proxy is apache2 ;
  cat <<EOF > /tmp/${NAME}
  <Location /${NAME}>
    Require all granted
    ProxyPass "http://${IP}:8080/${NAME}"
    ProxyPassReverse "http://${IP}:8080/${NAME}"
  </Location>
EOF

  lxc file push /tmp/${NAME} proxy/etc/apache2/upstream/${NAME}
  rm /tmp/${NAME}
  
  if [[ $GLOWROOT == yes ]]
  then
    cat <<EOF > /tmp/${NAME}-glowroot
  <Location /${NAME}-glowroot>
    Require all granted
    ProxyPass "http://${IP}:4000/${NAME}-glowroot"
    ProxyPassReverse "http://${IP}:4000/${NAME}-glowroot"
  </Location>
EOF

    lxc file push /tmp/${NAME}-glowroot proxy/etc/apache2/upstream/${NAME}-glowroot
    rm /tmp/${NAME}-glowroot
  fi
  
  lxc exec proxy -- service apache2 restart
else
  echo "Error: Proxy type not supported"
  exit 1
fi

echo "$NAME: DHIS2 $RELEASE is starting at $(server_base_url)/$NAME (the first start takes a few minutes)"
